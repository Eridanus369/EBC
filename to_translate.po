msgid ""
"Lighting nodes can't be connected to the Color sockets of a Light "
"Accumulation node"
msgstr "光照节点无法连接到光累加节点的颜色插槽"

msgid ""
"Lighting nodes must be connected to the Light sockets of a Light "
"Accumulation node before reaching the Material Output"
msgstr "光照节点必须在到达材质输出之前，连接到光累加节点的光插槽"

#, c-format
msgid ""
"Material %s could not be converted because of different Blend Mode and "
"Shadow Mode (need manual adjustment)\n"
msgstr "材质 %s 因混合模式和阴影模式不同而无法转换（需要手动调整）\n"

#, c-format
msgid ""
"Material %s could not be converted because of non-trivial alpha blending "
"(need manual adjustment)\n"
msgstr "材质 %s 因非平凡的 Alpha 混合而无法转换（需要手动调整）\n"

#, c-format
msgid ""
"Mesh %s has invalid faces, likely caused by the manifold extrude tool in "
"version 2.90.0. Opening and saving the file in a version prior to 5.1 should "
"resolve the issue\n"
msgstr "网格 %s 包含无效面，可能是由 2.90.0 版本中的流形挤出工具引起的。在 5.1 之前的版本中打开并保存该文件应可解决此问题\n"

msgid "Mode only available for mesh objects"
msgstr "模式仅适用于网格物体"

msgid ""
"Move inside collection (Ctrl to link, Shift to parent, Ctrl + Shift to move "
"only parent)"
msgstr "移动到集合内（Ctrl 关联，Shift 设为父级，Ctrl + Shift 仅移动父级）"

msgid "Move parent object inside collection"
msgstr "将父物体移动到集合内"

msgid "NPR Surface Diffusion is evaluated only by the Eevee render engine"
msgstr "NPR 表面漫射仅由 Eevee 渲染引擎评估"

